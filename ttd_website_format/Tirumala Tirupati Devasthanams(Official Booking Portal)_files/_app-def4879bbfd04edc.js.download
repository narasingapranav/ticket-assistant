ntinue","trackApdBookCancel","trackApdBookNow","trackApdDownloadTicket","trackApdSendToEmail","trackApdTranHistoryClick","trackApdBookingDetailsOnLoad","trackDashboardMuteClick","trackDashboardBannerClick","trackDashboardServicesClick","trackDashboardFooterClick","trackDashboardVideoClick","trackAccommodationTNCConfirmationClick","trackAccommodationSlotBookingContinueClick","trackAccommodationSlotBookingRefreshViewTransactionClick","trackAccommodationPilgrimDetailContinueClick","trackAccommodationPilgrimDetailCancelClick","trackAccommodationPilgrimDetailChangeNumberClick","trackAccommodationReviewDetailsPayNowClick","trackAccommodationReviewDetailsCancelClick","trackAccommodationBookingDetailsOnLoad","trackAccommodationBookingDetailsDownloadClick","trackAccommodationBookingDetailsSendToEmailClick","trackAccommodationBookingDetailsTransactionHistoryClick","trackAccommodationTransactionHistoryCancelTicketClick","trackAccommodationTransactionHistoryCancelTicketConfirmationClick","trackSevaDipClick","trackSevaDipGeneralDataClick","trackSevaDipPaymentResponseClick","trackDashboardWebClick","trackInAppBanner","trackTTDWebDashboard","trackTTdWebLogin","trackTTDWebLogout","trackTermsAndConditionsClickAction","trackSmartAppBannerClick","trackSwamyvariBookingClick","trackbookingDetailsHundi","trackArjithaSeva","trackArjithaGeneralData","trackArjithaPayment","trackVirtualSeva","trackVirtualSevaPayment","trackTemples"],r=function(e,a){window.dataLayer.push(a)},s=function(){n.getAll().forEach(function(e){r(e.eventName,e.eventData),n.remove()})};function l(e,a){o.indexOf(e)>=0&&(window.gtmInitiated?(s(),r(e,a)):n.push({eventName:e,eventData:a}))}},16275:function(e,a,t){"use strict";t.d(a,{Z:function(){return i}});var i={en:{footer:{copyrightText:"Copyright \xa9  2016. Tirumala Tirupati Devasthanams - All rights reserved"},reviewDetails:{txtChangeDetails:"Change Details",txtPaymentOptions:"Payment Options",txtPaymentGateway:"Choose Payment Gateway",txtPaymentInstruction1:"Note: All Debit / Credit Cards & Net Banking are accepted.",txtPaymentInstruction2:"Additional payment gateway charges are applicable.",paymentGateway1:"HDFC Payment Gateway",paymentGateway1Notes:"Charges: Netbanking - Nil, Debit cards (Visa & Mastercard) - Nil, Credit cards - Nil",paymentGateway2:"SBI Payment Gateway",paymentGateway2Notes:"Charges: SBI Netbanking -Nil, Other Netbanking - Rs. 20, Debit cards - Nil, Credit card Domestic - 1.90%, Credit Card Corporate - 2.15%",paymentNoteP1:"Clicking",paymentNoteP2:"Pay Now",paymentNoteP2SsdFlow:"Book Now",paymentNoteP3:"confirms your acceptance of the",paymentNoteP4:"Terms and Conditions",cancelButton:"Cancel",payNowButton:"Pay Now",bookNowButton:"Book Now",popupInstructions:["Terms and Conditions for the Darshan","Tirumala Tirupati Devasthanams is a charitable trust which supervises the administrative functions necessary to conduct the various traditional rituals at Sri Venkateswara Temple, Tirumala.","TTD does not solicit or canvass for any offering. TTD has its own fund, the corpus of which, shall include all the amounts received by it by way of offering, gifts, kanukas, including offerings deposited in Hundi and any income from any other source as per sec 111 of A.P.Charitable and Hindu Religious Institutions and Endowments Act 1987.","It is hereby made clear that all offerings made through the online facility are accepted by TTD as a non-reclaimable transfer to the Lord's Hundi and the donor is not entitled to any claim that may be available to a consumer under this payment mode. You have read and agreed to disclaim any claim that may accrue to you as a customer in an online transaction, in view of the special nature of these services.","Please go through the disclaimer, privacy policy and copyright in the terms and conditions provided at the right hand bottom corner of the page."],tncp1:"Terms and Conditions for the Darshan",tncp2:"Tirumala Tirupati Devasthanams is a charitable trust which supervises the administrative functions necessary to conduct the various traditional rituals at Sri Venkateswara Temple, Tirumala.",tncp3:"TTD does not solicit or canvass for any offering. TTD has its own fund, the corpus of which, shall include all the amounts received by it by way of offering, gifts, kanukas, including offerings deposited in Hundi and any income from any other source as per sec 111 of A.P.Charitable and Hindu Religious Institutions and Endowments Act 1987.",tncp4:"It is hereby made clear that all offerings made through the online facility are accepted by TTD as a non-reclaimable transfer to the Lord's Hundi and the donor is not entitled to any claim that may be available to a consumer under this payment mode. You have read and agreed to disclaim any claim that may accrue to you as a customer in an online transaction, in view of the special nature of these services.",tncp5:"Please go through the disclaimer, privacy policy and copyright in the terms and conditions provided at the right hand bottom corner of the page.",tncHeader:"Terms and Conditions"},header:{entryLabel:"Special Entry Darshan",homeLabelForEntry:"Special Entry Darshan Availability",sarvaDarshanamLabel:"Sarva Darshanam (Free)",sarvaDarshanam:"Sarva Darshanam",transactionHistory:"Transaction History",onlineServices:"Online Services",ttdOnlineServices:"TTD Online Services",editProfile:"Edit Profile",myProfile:"My Profile",tirumalaDevsthanams:"Tirumala Tirupati Devasthanams",tirumalaDevsthanamsLang:"తిరుమల తిరుపతి దేవస్థానములు",faq:"Help & FAQs",login:"Login",contactUs:"Contact Us",feedback:"Feedback",menu:"Menu",greetingsMorning:"Namaskaram Pilgrim,",greetingsAfterNoon:"Namaskaram Pilgrim,",greetingsEvening:"Namaskaram Pilgrim,",venkateshaChant:"Om Namo Venkatesaya",videos:"Videos",wallpapers:"Wallpapers",dosDonts:"Do’s & Don’ts",termsConditions:"Terms and Conditions",ringtones:"Ringtones",announcements:"Announcements "},slotBooking:{pilgramText1APD:"The Pilgrim(s) can participate in Angapradakshinam of Lord Venkateswara at Tirumala temple by booking the tickets well in advance through https://ttdevasthanams.ap.gov.in. Please read the ",pilgramText1T:"A pilgrim can avail the darshan of Sri Padmavathi Ammavaru, Tiruchanoor by booking 'Special Entry Darshan (Sri PAT)' tickets well-in advance through ttdevasthanams.ap.gov.in. Please read the ",pilgramText1:"A pilgrim can avail the darshan of Lord Sri Venkateswara, Tirumala by booking 'Special Entry Darshan' tickets well-in advance through ",pldPilgramText1:"A pilgrim can avail the darshan of Lord Sri Venkateswara, Tirumala by booking 'Differently Abled/ Sr. Citizen/Medical Cases' tickets well-in advance through ttdevasthanams.ap.gov.in. Please read the ",pilgramInstructions:"Instructions",popupInstructions:[" At the time of entry, all pilgrims shall produce the same original Photo ID used during booking. Age proof shall be produced for children below 12 years to gain entry free of cost."," The pilgrims shall wear Traditional Dress only.  Male:  Dhoti, Shirt / Kurtha, Pyjama.  Female:  Saree / Half Saree / Chudidar with Dupatta. "," Pilgrims who book for Darshan should bring the printed copy of their receipt. "," All the Pilgrims in group ticket have to report together. "," The pilgrims should not carry any luggage/cell phones/electronic gadgets while reporting. "," All bookings are FINAL: Postponement/advancement/cancellation/refund is not allowed."," Entry with foot wear is not permitted into the queue lines, mada streets and Temple. "," TTD reserves the right of cancellation of Darshan under Special Circumstances.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh."," For more information, Please contact TTD Call Centre (24X7) on 155257 "],popupInstructionsTemple:[" At the time of entry, all pilgrims shall produce the same original Photo ID used during booking. Age proof shall be produced for children below 12 years to gain entry free of cost."," The pilgrims shall wear Traditional Dress only.  Male:  Dhoti, Shirt / Kurtha, Pyjama.  Female:  Saree / Half Saree / Chudidar with Dupatta. "," Pilgrims who book for Darshan should bring the printed copy of their receipt. "," All the Pilgrims in group ticket have to report together. "," The pilgrims should not carry any luggage/cell phones/electronic gadgets while reporting. "," All bookings are FINAL: Postponement/advancement/cancellation/refund is not allowed."," TTD reserves the right of cancellation of Darshan under Special Circumstances.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh.","For more information, Please contact TTD Call Centre (24X7) on 155257 "],tnc1:" At the time of entry, all pilgrims shall produce the same original Photo ID used during booking. Age proof shall be produced for children below 12 years to gain entry free of cost.",tnc11:" At the time of entry, all pilgrims shall produce the same original Photo ID used during booking.",tnc12:" Age proof shall be produced for children below 12 years to gain entry free of cost.",tnc6:" All bookings are FINAL: Postponement/advancement/cancellation/refund is not allowed.",pilgramText2:"  before proceeding with booking.",pilgramText2APD:"  before proceeding.",available:"Available",quotaIsFull:"Quota is Full",quotaNotReleased:"Quota Not Released",slotNotAvailable:"Slot Not Available",tncLabel:"We will abide by the latest Covid-19 norms issued by the Central / State Government.",note1:" Pilgrims can book Accommodation for Tirumala location only if there is a valid Special Entry Darshan booking.",note2:"Option to book Tirumala Accommodation will be available in the Transaction History or Home page against your Special Entry Darshan booking.",note3:"Accommodation booking is allowed only for one day, either on the same day or previous day of Darshan date.",note4:"Accommodation bookings will not be allowed for the current day.",noteLabel:"Note",selectedDateLabel:"Selected Date is ",noOfPerson:"No. of Persons:",noOfLaddu:"No. of additional Laddus:",hundiOffering:"Hundi Offerings(Optional):",ladduNote:"(₹50.00 cost per laddu)",ladduNote25:"(₹25.00 cost per laddu)",hundiOfferingNote:"Hundi contributions are receivable only in Indian Rupees.",cancel:"Cancel",back:"Back",continue:"Continue",reschedule:"Reschedule",hundiError:"Please enter a valid amount",ladduError:"Minimum of 1, Maximum of 999 Laddus are accepted",noOfPersonError:"please enter no of persons",selectSlot:"Please select a darshan ticket",selectDate:"Please select Darshan available date",selectTnc:"Please agree to continue",pilgramText1Ssd:'A pilgrim can avail the darshan of Lord Sri Venkateswara, Tirumala by booking "Sarva Darshan (free)" tickets well-in advance through ttdevasthanams.ap.gov.in. Please read the ',pilgramText2Ssd:' before proceeding with booking. Do not reload your browser. Please click on "Refresh slots" button for getting latest availability.',ssdNote1:"Pilgrims can book Accommodation for Tirumala location only if there is a valid Sarva Darshan booking.",ssdNote2:"Option to book Tirumala Accommodation will be available in the Transaction History or Home page against your Sarva Darshan booking.",refreshSlots:"Refresh slots",refresh:"Refresh",fillingFast:"Filling Fast",updatedNote1:"Pilgrims without valid Darshan tickets will not be allowed to Tirumala.",updatedNote2:"Selection of seva does not imply booking confirmation. Only after entering pilgrim details and clicking on “Pay Now” button the selected seva ticket(s) will be blocked subject to availability at that instance.Pilgrims without valid Darshan tickets will not be allowed to Tirumala.",sedTempleNote:"Pilgrims without valid Darshan tickets will not be allowed to SRI PAT, Tiruchanoor",talakona:{note:"Pilgrims to make a note that the Talakona location is 58 kilometers away from Tirupati",header:"TTD online booking portal"},vontimitta:{note:"Pilgrims to make a note that the Vontimitta location is 117 kilometers away from Tirupati",header:"TTD online booking portal"}},slotBookingBreakDarshan:{note1:"Selection of Darshan/seva does not imply booking confirmation. Only after entering pilgrim details and clicking on “Pay Now” button the selected Darshan/seva ticket(s) will be blocked subject to availability at that instance.Pilgrims without valid Darshan tickets will not be allowed to Tirumala.",note2:"At the time of entry, all pilgrims shall produce the same original Photo ID used during booking. Age proof shall be produced for children below 12 years to gain entry free",note3:"All bookings are FINAL: Postponement/ advancement/ cancellation/ refund is not allowed.",beforeInstructions:"Please read ",popupInstructions:["The reporting place for availing Darshan is at\xa0VQC-I, TIRUMALA","At the time of entry, the pilgrim shall produce the same original Photo ID used during booking. Pilgrim should bring the printed copy of their receipt for availing Darshan","Age proof shall be produced for children below 12 years for availing Darshan at no cost","The Pilgrims shall wear traditional dress only. Male: Dhoti, Shirt/Upper Cloth, Female: Saree / Half Saree, Chudidar with dupatta","All the pilgrims in group tickets have to report together","The Pilgrims should not carry any luggage/ cell phones/ electronic gadgets while reporting for Darshan","Entry with chappals / shoes is not permitted into the Queue Lines, Mada Streets and Temple","All bookings are final: Postponement/ Advancement / Cancellation / Refund is not allowed","TTD reserves the right of cancellation of the Darshan under any special circumstances","Please contact our 24/7 helpdesk for queries at 155257"]},pldSlotBooking:{pilgramText1:'A pilgrim can avail the darshan of Lord Sri Venkateswara, Tirumala by booking "Differently Abled/ Sr. Citizen/Medical Cases" tickets well-in advance through ttdevasthanams.ap.gov.in. Please read the ',pilgramInstructions:"instructions",popupInstructions:"Instructions",pilgramText2:"  before proceeding with booking.","Terms and Conditions":["Terms and Conditions for the Darshan","Tirumala Tirupati Devasthanams is a charitable trust which supervises the administrative functions necessary to conduct the various traditional rituals at Sri Venkateswara Temple, Tirumala.","TTD does not solicit or canvass for any offering. TTD has its own fund, the corpus of which, shall include all the amounts received by it by way of offering, gifts, kanukas, including offerings deposited in Hundi and any income from any other source as per sec 111 of A.P.Charitable and Hindu Religious Institutions and Endowments Act 1987.","It is hereby made clear that all offerings made through the online facility are accepted by TTD as a non-reclaimable transfer to the Lord's Hundi and the donor is not entitled to any claim that may be available to a consumer under this payment mode. You have read and agreed to disclaim any claim that may accrue to you as a customer in an online transaction, in view of the special nature of these services.","Please go through the disclaimer, privacy policy and copyright in the terms and conditions provided at the right hand bottom corner of the page."],instructions:["The pilgrims shall wear Traditional Dress only. Male: Dhoti, Shirt / Kurta, Pyjama. Female: Saree / Half Saree / Chudidar with Dupatta.","Pilgrims who book for Darshan should bring the printed copy of their receipt.","The pilgrims should not carry any luggage/cell phones/electronic gadgets while reporting.","All bookings are FINAL: Postponement/advancement/cancellation is not allowed.","If any delay with the reporting time due to any circumstances, pilgrims has to avail the darshan from Sarva Darshanam only.","Different Abled person if any has to provide the Differently Abled certificate provided by State / Govt of India.","Any pilgrim with Medical issues, has to provide valid medical certificate from concern Surgeon/Specialist.","Entry with foot wear is not permitted into the queue lines, mada streets and Temple.","TTD reserves the right of cancellation of Darshan under Special Circumstances.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh.","For more information, Please contact TTD Call Centre (24X7) on 155257."],tnc11:" Different Abled person if any has to provide the Differently Abled certificate provided by State / Govt of India.",tnc12:" Any pilgrim with Medical issues, has to provide valid medical certificate from concern Surgeon/Specialist.",footerTnc1:"Pilgrims without valid ticket Darshan will not be allowed to Tirumala",footerTnc2:"At the time of entry, Pilgrim shall produce the same original photo ID used during booking.",footerTnc3:"All bookings are FINAL: Postponement/advancement/cancellation is not allowed.",footerTnc4:"If any delay with the reporting time due to any circumstances, pilgrims has to avail the darshan from Sarva Darshanam only.",footerTnc5:"Different Abled person if any has to provide the Differently Abled certificate provided by State / Govt of India.",footerTnc6:"Any pilgrim with Medical issues, has to provide valid medical certificate from concern Surgeon/Specialist.",available:"Available",quotaIsFull:"Quota is Full",quotaNotReleased:"Quota Not Released",slotNotAvailable:"Slot Not Available",tncLabel:"By clicking continue you agree to the selected time slot",note1:" Pilgrims can book Accommodation for Tirumala location only if there is a valid Special Entry Darshan booking.",note2:"Option to book Tirumala Accommodation will be available in the Transaction History or Home page against your Special Entry Darshan booking.",note3:"Accommodation booking is allowed only for one day, either on the same day or previous day of Darshan date.",note4:"Accommodation bookings will not be allowed for the current day.",noteLabel:"Note:",selectedDateLabel:"Selected Date is ",noOfPerson:"No. of Persons:",cancel:"Cancel",continue:"Continue",reschedule:"Reschedule",noOfPersonError:"please enter no of persons",selectSlot:"Please select a darshan slot",selectDate:"Please select Darshan available date",selectTnc:"Please agree to continue",pilgramText1Ssd:"A pilgrim can avail the darshan of Lord Sri Venkateswara, Tirumala by booking 'Sarva Darshan (free)' tickets well-in advance through ttdevasthanams.ap.gov.in. Please read the ",pilgramText2Ssd:' before proceeding with booking. Do not reload your browser. Please click on "Refresh slots" button for getting latest availability.',ssdNote1:"Pilgrims can book Accommodation for Tirumala location only if there is a valid Sarva Darshan booking.",ssdNote2:"Option to book Tirumala Accommodation will be available in the Transaction History or Home page against your Sarva Darshan booking.",refreshSlots:"Refresh slots",refresh:"Refresh",fillingFast:"Filling Fast",updatedNote1:"Pilgrims without valid Darshan tickets will not be allowed to Tirumala.",category:"Category",seniorCitizen:"Senior Citizen",medicalCases:"Medical Cases",differentlyAbled:"Differently Abled",categoryError:"Please select category",ageError:"Please enter age",disabilityError:"Please select disability",medicalReason:"Please select medical reason",attendant:"Accompany with the Spouse",ageLimit:"Age should be min 65 and max 150",diabilityCharacterLimit:"Cannot allow more than 20characters",diabilityPercentageLimit:"Disability Percent should be min 21 and max 100",disability:"Disability",disabilityPercent:"Disability Percent",diabilityPlaceHolder:"Enter disability",diabilityPlacePercentHolder:"Enter percentage",attendantRequired:"Please select if Attendant is Required"},calender:{jan:"JANUARY",feb:"FEBRUARY",mar:"MARCH",apr:"APRIL",may:"MAY",jun:"JUNE",jul:"JULY",aug:"AUGUST",sept:"SEPTEMBER",oct:"OCTOBER",nov:"NOVEMBER",dec:"DECEMBER",Sun:"Sun",Mon:"Mon",Tue:"Tue",Wed:"Wed",Thu:"Thu",Fri:"Fri",Sat:"Sat"},"customer-details":{mobileNumber:"Mobile number",apdBookingTxt:"Pilgrims Details",bookingSelfTxt:"Pilgrim Details",changeDetails:"Change Details",totalCost:"Total Cost",darshanDate:"Darshan Date",changeNumber:"Change number",noOfPerson:"No of Persons",timeSlot:"Time Slot",darshanSlot:"Darshan Slot",noOfTickets:"No. of Tickets",note:"Note:",continue:"Continue",continueToPayment:"Continue to Payment",cancel:"Cancel",back:"Back",fieldMrked:"Fields marked ",mandatory:"are mandatory",nameErr:"Name cannot be empty",enterAgeErr:"Please enter the age",validNameErr:"Please enter a valid Name",photoIdErrMsg:"Photo ID Card Number cannot be empty",selectGenderErr:"Please select a Gender",validAgeErr:"The valid age allowed to book is 12 to 120 years",validAgeSpouseErr:"The valid age allowed to book is 50 to 120 years",validAgeSpouseErrNonSeniorCitizen:"The valid age allowed to book is 0 to 120 years",validIDMsg:"Please select a valid Photo ID Proof",validAadharErr:"Please enter valid Aadhar Number",validPassportErr:"Please enter valid Passport Number",validVoterErr:"Please enter valid Voter ID Number",duplicatePhotoIdErrMsg:"Duplicate ID card numbers cannot be submitted",uploadDocument:"Upload document",uploadedDocument:"Document uploaded",uploadDocumentSubTxt:"(Please upload file size max 1 MB with extensions .jpeg, .png, .pdf only)",uploadDocumentSubTxtMobile:"(Please upload file size max 1 MB with extensions .jpeg, .png only)",categoryLbl:"Category",addressLine1:"Address Line 1",addressLine2:"Address Line 2",lblCountry:"Country",lblState:"State",lblPincode:"Pincode",lblCity:"City",lblPilgrimMobileNo:"Pilgrim’s Mobile No.",err_city:"Please enter the city",err_pincode:"Please enter the pincode",err_mobileNumber:"Please enter the mobile no",err_state:"Please enter the state",err_country:"Please enter the country",err_emailId:"Please enter valid email id",CitylimitErr:"Please enter valid city name",PincodelimitErr:"Please enter valid pincode",sevaAmount:"Seva Amount",noOfLaddus:"No. of Laddus",hundiOffering:"Hundi Offerings"},receipt:{instructionsHeaderTxt:"Important Information To The Pilgrims",instructionTxt1:"At the time of entry, all the pilgrims should carry individual ticket and shall produce the same original photo ID used during booking.",instructionTxt2:"The Pilgrims shall wear traditional dress only. Male: Dhoti, Shirt/Kurtha, Pyjama. Female: Saree/Half saree/Chudidar with dupatta.",instructionTxt3:"All the pilgrims shall report as per their time slot only and should not carry any luggage/electronic gadgets while reporting.",instructionTxt4:"Pilgrim having darshan slot will be allowed by Road through Alipiri, only after 1 PM  on the previous day of darshan.",instructionTxt5:"Pilgrim having darshan slot will be allowed through Alipiri/Srivari Mettu Foothpaths, only after 9 AM on the previous day of darshan.",instructionTxt6:"Pilgrims shall collects the Prasadam within 24 Hrs from the reporting time for Darshan.",instructionTxt7:"All bookings are final; Postponement / Advancement / Cancellation / Refund is not allowed.",instructionTxt8:"TTD reserves the right of cancellation of Darshan under Special Circumstances.",instructionTxt9:"Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.",instructionTxt10:"All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh",updatedIstructions:["At the time of entry, all the pilgrims should carry individual ticket and shall produce the original photo ID used during booking.","The original ticket holder must be present to avail the Darshan; proxies are strictly not permitted.","Prasadam is a sacred offering and will be given at no cost only when the original ticket holder avails the Darshan.","Pilgrims shall collect the Prasadam within 24 hours from the time of reporting for Darshan.","The pilgrims shall wear traditional dress only.  Male: Dhoti, Shirt/Kurtha, Pyjama. Female: Saree/Half/Chudidar with dupatta.","[B] All the pilgrims shall report as per their Time-Slot only and should not carry any luggage/electronic gadgets while reporting.  The pilgrims will be allowed in Q-lines prior to one hour from their scheduled slots only.","All bookings are final.  Postponement/advancement/cancellation/ Refund are not allowed.","Pilgrims with cardiac disease and other comorbidities likes diabetes, hypertension are advised to avoid climbing.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","TTD reserves the right of cancellation of Darshan under Special Circumstances."],vddpassportIntructions:["Your Vaikunta Dwara Darshanam booking for [Darshan Date]  is successful.","You have made booking using Passport as Non-Resident Indian (NRI) / Foreigner, in view of security reasons, TTD is not issuing the Darshan Tickets online.","You are requested to approach at [Report At], Tirumala at your Darshan time slot and produce your original passport used while booking and obtain the Darshan Ticket.","The Pilgrims shall wear traditional dress only. Male: Dhoti, Shirt/Kurtha, Pyjama. Female: Saree/Half saree/Chudidar with dupatta.","No additional charges will be collected for Darshan Ticket.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","TTD reserves the right of cancellation of Darshan under special circumstances."],passportInstructions1:"Your Special Entry Darshan booking for [Darshan Date] is successful.",passportInstructions2:"You have made booking using Passport as Non-Resident Indian (NRI) / Foreigner, in view of security reasons, TTD is not issuing the Darshan Tickets online.",passportInstructions3:"You are requested to approach [Reporting Location] at your Darshan time slot and produce your original passport used while booking and obtain the Darshan Ticket.",passportInstructions4:"The Pilgrims shall wear traditional dress only. Male: Dhoti, Shirt/Kurtha, Pyjama. Female: Saree/Half saree/Chudidar with dupatta.",passportInstructions5:"No additional charges will be collected for Darshan Ticket.",passportInstructions6:"TTD reserves the right of cancellation of Darshan under special circumstances.",passportInstructions7:"Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.",noteTxt:"NOTE: This is an electronically generated document and does not require any signature.",authorityTxt:"Executive Officer, Tirumala Tirupati Devasthanams",headerTxt1:"Tirumala Tirupati Devasthanams",headerTxtTelugu:"తిరుమల తిరుపతి దేవస్థానములు ",headerTxt2:"Special Entry Darshan(Sri TT) (Rs.300)",headerTxtPassport:"Special Entry Darshan(Sri TT) for NRI/Foreigners (Rs.300)",accommodationReceiptTxt:"Accommodation Receipt",headerTxt2Privilge:"Differently Abled/Sr. Citizen/Medical Cases",headerTxt2SSD:"Slotted Sarva Darshan (Sri PAT)",freeLadduTxt:"No. of free laddus:",addnLadduTxt:"Additional Laddus:",addnLadduAmnt:"Additional Laddus Amount:",hundiOffr:"Hundi Offering:",totalAmnt:"Total Amount:",grpBooikngTxt:"Group Booking Id:",bookingDate:"Booking Date:",photoid:"Photo ID Number:",nameTxt:"Pilgrim Name:",gender:"Gender/Age:",reportingTime:"Reporting Time:",reportAt:"Report At:",ticketNotAvailable:"Darshan ticket is not available yet. You will receive an SMS confirmation of your bookings when the transaction is successfully processed by the bank.",ticketNotAvailable2:"Kindly reload this page later.",amount:"Amount:"},sevaReceipt:{Note:"Important Information to the Pilgrims:",instructions:["At the time of entry, all the pilgrims should carry seva ticket and shall produce the same original photo id proof during booking.","NRI pilgrims shall produce passport with valid visa/PR.","All the pilgrims shall report as per the prescribed time only and should not carry any luggage/electronic gadgets while reporting.","Pilgrims shall wear traditional dress only. (Male: dhoti and upper cloth. Female: saree/Half saree/chudidar with Duppatta).","All the pilgrims in group ticket have to report together.","Children’s [Below 12years of age] are not permitted during morning sevas without seva ticket i.e. Thomala, Archana & Abhishekam seva.","Pilgrims shall collect the Prasadam within 24 hrs from the reporting time.","All the bookings are final: postponement/ cancellation/advancement is not allowed.","TTD reserve the right of cancellation of seva/darshan under any circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","For any information please contact [B]155257."],apdInstructions:["Pilgrims should report at Special Entry Complex, Vaikuntam-1 as per the specified reporting time only and should not carry any luggage/electronic gadgets while reporting.","Pilgrims participating in Angapradakshinam seva must be in a traditional dress code; Male: Dhoti and upper, Female: Saree / Half saree/ Chudidar with Duppatta","Ladies and gents will be separated to perform Angapradakshinam.","To perform Angapradakshinam, the pilgrim(s) shall attend in wet clothes.","At the time of entry, all the pilgrims should carry individual ticket and shall produce the same original photo id proof used while booking.","Pilgrims shall collect the Laddu Prasadam within 24 hrs from the reporting time for Angapradakshinam.","All the bookings are final: postponement/ cancellation/advancement is not allowed.","TTD reserve the right of cancellation of Seva / Darshan under any circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","For more information, Please contact TTD Call Centre (24X7) on 155257."],apdPassportInstructions:["Your Angapradakshinam booking for [booking_date] is successful.","You have made booking using Passport as Non-Resident Indian (NRI) / Foreigner, in view of security reasons, TTD is not issuing the Angapradakshinam Tickets online.","You are requested to approach “SED Complex, Vaikuntam – 1, Tirumala” at your Angapradakshinam reporting time and produce your original passport used while booking and obtain the Angapradakshinam Ticket.","Pilgrims should not carry any luggage/electronic gadgets while reporting.","Pilgrims participating in Angapradakshinam must be in a traditional dress code. Male: Dhoti and upper, Female: Saree / Half saree/ Chudidar with Duppatta","Ladies and gents will be separated to perform Angapradakshinam.","To perform Angapradakshinam, the pilgrim(s) shall attend in wet clothes.","Pilgrims shall collect the Laddu Prasadam within 24 hrs from the reporting time for Angapradakshinam.","All the bookings are final: postponement/ cancellation/advancement is not allowed.","TTD reserve the right of cancellation of Seva / Darshan under any circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","For any information, please contact 155257."],passportInstructions:["Your Seva booking for [Darshan Date] is successful.","You have made booking using Passport as Non-Resident Indian (NRI) / Foreigner, in view of security reasons, TTD is not issuing the Seva Tickets online.","You are requested to approach “VQC-1, Tirumala” at your Seva reporting time and produce your original passport used while booking and obtain the Seva Ticket.","No additional charges will be collected for Seva Ticket.","The Pilgrims shall wear traditional dress only. Male: Dhoti, Shirt/Kurtha, Pyjama. Female: Saree/Half saree/Chudidar with dupatta.","Children’s [Below 12 years of age] are not permitted during morning sevas without seva ticket i.e. Thomala, Archana & Abhishekam seva.","Pilgrims shall collect the Prasadam within 24 hrs from the reporting time.","All the bookings are final: postponement/ cancellation/advancement is not allowed.","TTD reserve the right of cancellation of seva/darshan under any circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","For any information please contact 155257."]},pldReceipt:{instructionsHeaderTxt:"Important Information To The Pilgrims",instructionTxt0:"Pilgrims shall produce Certificate for Person with Disability issued by the State / Central Government.",instructionTxt1:"Pilgrims shall produce valid medical certificate issued by the respective Surgeon / Specialist.",instructionTxt2:"At the time of entry, Pilgrim shall produce the same original photo ID used during booking.",instructionTxt3:"All the pilgrims shall invariably report as per reporting time only and should not carry any luggage/electronic gadgets while reporting.",instructionTxt4:"The Pilgrims shall wear traditional dressed only. Male: Dhoti, Shirt / Kurtha, Pyjama. Female: Saree/Half saree/Chudidar with dupatta.",instructionTxt5:"This service will be open for specific time only, in case of delay in reporting for Darshnan, pilgrim has to avail Sarva Darshan only.",instructionTxt6:"One Free Laddu will be provided per pilgrim after availing Darshan, pilgrims shall collect the Prasadam within 24 Hrs. from the time of reported for Darshan.",instructionTxt7:"All bookings are final; Postponement / Advancement / Cancellation are not allowed.",instructionTxt8:"TTD reserves the right of cancellation of Darshan under Special Circumstances.",instructionTxt9:"Please contact 24X7 TTD Call Centre on 155 257 for queries / clarifications if any.",instructionTxt10:"Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.",instructionTxt11:"TTD management is authorized to cancel the booking tickets if found any discrepancy.",instructionTxt12:"All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh",noteTxt:"NOTE: This is an electronically generated document and does not require any signature.",authorityTxt:"Executive Officer, Tirumala Tirupati Devasthanams",headerTxt1:"Tirumala Tirupati Devasthanams",headerTxt2:"Differently Abled/Sr. Citizen/Medical Cases",accommodationReceiptTxt:"Accommodation Receipt",headerTxt2Privilge:"Differently Abled/Sr. Citizen/Medical Cases",headerTxt2SSD:"Sarva Darshanam (Free)",freeLadduTxt:"No. of free laddus:",addnLadduTxt:"Additional Laddus:",addnLadduAmnt:"Additional Laddus Amount:",hundiOffr:"Hundi Offering:",totalAmnt:"Total Amount:",grpBooikngTxt:"Group Booking Id:",bookingDate:"Booking Date:",photoid:"Photo ID Number:",nameTxt:"Pilgrim Name:",gender:"Gender/Age:",reportingTime:"Reporting Time:",reportAt:"Report At:",ticketNotAvailable:"Darshan ticket is not available yet. You will receive an SMS confirmation of your bookings when the transaction is successfully processed by the bank.",ticketNotAvailable2:"Kindly reload this page later.",amount:"Amount:"},"accommodation-slot":{accommodationText:"A pilgrim can avail the accommodation facilities in Tirumala and Tirupati (Srinivasam) only with a valid darshan booking. Please read the ",importantNote:"IMPORTANT NOTE",popupInstructions:["The number of Persons allowed per booking will be based on the location selected.\n Ex: A minimum of 2 and maximum of 4 pilgrims are allowed for Tirupati location","Please avail additional rooms at Tirumala in case you have booked Darshan tickets for more than number of persons allowed.","Pilgrim can book Accommodation, with a minimum of 1 day on advance and a maximum of 120 days.","Multiple selections of accommodation is not allowed.","The ID proof given during the booking process should be carried (original copy) for availing accommodation.","No cancellation will be allowed one day before the availing date.","To know more about Accommodation, please visit: https://www.tirumala.org/AccommodationAtTirumala.aspx","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh."],tnc1:"Pilgrims without valid Darshan tickets will not be allowed to Tirumala.",tnc2:"The number of Persons allowed per booking will be based on the location selected.\n Ex: A minimum of 2 and maximum of 4 pilgrims are allowed for Tirupati location",tnc3:"Please avail additional rooms at Tirumala in case you have booked Darshan tickets for more than number of persons allowed.",tnc4:"Pilgrim can book Accommodation, with a minimum of 1 day on advance and a maximum of 120 days.",tnc5:"Multiple selections of accommodation is not allowed.",tnc6:"The ID proof given during the booking process should be carried (original copy) for availing accommodation.",tnc7:"No cancellation will be allowed one day before the availing date.",tnc8:"To know more about Accommodation, please visit: https://www.tirumala.org/AccommodationAtTirumala.aspx",tncLabel:"We will abide by the latest Covid-19 norms issued by the Central / State Government.",continuePopup:"The allotment of room is for 24 Hrs only. The pilgrim should get the room allotted within the slot timings selected while booking and invariably vacate the room within the check-out time.",popupTitle:"TTD Online booking portal",dateSelected:"Please select an available date",roomSelected:"Please select an available room",checkInSelected:"Please select Check-In Time Slots",locationSelected:"Please select the location",cautionDeposit:"Caution deposit (if any) will be refunded post vacation of room",noOfPerson:"No. of Persons",checkInTime:"Check-In Time Slot:",confirmationLabel:"Confirmation",confirmation1:"As part of Covid-19 precautions, pilgrims are not allowed to Tirumala without valid Darshan ticket. Pilgrims are requested to make a note of the above and book the accommodation accordingly.",confirmation2:"Please avail additional rooms at Tirumala in case you have booked Darshan tickets for more than number of persons allowed.",declaration:"I, on behalf of pilgrim(s) booking Accommodation tickets do hereby declare that :  ",confirmation3:"We have no history of Covid-19​.",confirmation4:"We will wear mask all the time and will maintain social distancing and sanitization / wash our hands frequently.",confirmation5:"We will abide by the latest Covid-19 norms issued by the Central / State Government.",confirmation6:"We will fully cooperate with Temple authorities with regard to Covid-19 and security measures under taken.",confirmTnc:"I / We Agree to the above conditions",agreedLabel:"Agree",stateOfResidence:"State of Residence",bookingCharges:"Charges Details",roomType1:"Room with 2 beds and attached toilet",roomType2:"Room with 2 beds and attached toilet",roomType3:"AC Room with 2 beds and attached toilet",bookingId:"Special Entry Darshan Booking Id:",ssdBookingId:"Sarva Darshan Booking Id:",pldBookingId:"Differently Abled / Sr. C / MC Booking Id:",transactionHistory:"View transaction history",accommodationTirumala:"Accommodation-Tirumala",accommodationAvailability:"Accommodation"},error:{failureError:"We are unable to process your request currently. Please try again after some time",errorPageText:"Please visit the TTD website for booking darshan seva."},"srivari-seva":{importantNote:["Only male candidate can register for this Seva","Duty deployment will be done based on DIP system by the Seva Sadan Staff."]},accInstructions:{accommodationIns:["One can eligible to get advance booking of accommodation against valid TTD Darshan/ Seva tickets of Sri TT only.","Room allotment will be for 24 hours only from the time of Allotment of Room.","Single person / Unmarried couple / Minors are not allowed to book accommodation.","Pilgrim is permitted to book 1 (One) room within a span of 30 (Thirty) days against Seva/Darshan Ticket of Sri TT.","Pilgrim will be permitted to get accommodation within the specified slot timings. No further Consideration will be made In the event of failed to utilize within stipulated time slot.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh.","All rights reserved with TTD."]},"accommodation-review-details":{lblAccomodationOn:"Accommodation on",lblLocation:"Location",lblCheckIn:"Check-in Time",lblCheckInDate:"Check In Date",lblCheckOutDate:"Check Out Date",lblCheckInTime:"Check In Time",lblBaseTarrif:"Base Tariff",lblDeposit:"Caution Deposit",lblCost:"Total Cost",lblGst:"(including GST)",lblChangeDetails:"Change Details",idSpecialEntry:"Special Entry Darshan Booking Id",idSarvaDarshan:"Sarva Darshan Booking Id",lblState:"State of Residence",lblMessage:"Either of the pilgrim entered below can avail accommodation in stipulated time slot and date.",checkin_date:"Check in Date",noOfPilgrims:"No. of Pilgrims"},accommodationReceipt:{instructionsHeaderTxt:"Important Information to the Pilgrims:",instructionTxt01:"The accommodation printout should scan at ARP COUNTER in CRO office, Tirumala. The room allotment information will be sent through SMS to the registered mobile number within 15 minutes along with reporting location.",instructionTxt02:'"Alipiri Toll Gate / Alipiri Footpath / Srivari Mettu Foothpath to get the room allotment"',instructionTxt03:"If SMS is not received within 15 minutes, one should approach ARP counter staff for room confirmation. And should directly go to the concerned Sub-enquiry office to get the room allotment within 2 hours from the time of SMS sent by TTD. Otherwise, the room allotment will automatically get expires and no further consideration shall be made in any circumstances.",instructionTxt1:"Pilgrims not possessing a valid Darshan tickets are not allowed to Tirumala, even if they possess valid accommodation receipt. ",instructionTxt2:"Please avail additional rooms at Tirumala in case you have booked Darshan tickets for more than the allowed persons.",accommodationReceiptNotesVishnunivasam:["The allotment of room is only for 24 hours and no extension is allowed. Pilgrims should invariably vacate the room within 24 hours.","If the pilgrims fail to avail the accommodation in stipulated timeslot and date, the booking itself will get expire and no consideration will be made in any circumstances.","The Pilgrim should produce the original ID proof at the time of availing the Accommodation.","Rooms shall not be issued to the Single Person, Unmarried couples and Pilgrim with Local ID Proof.","Caution deposit will be refunded to the original source of payment within 7 banking days, after in-time vacation of the room.","Pilgrims can cancel their Accommodation bookings before minimum 48 hours of accommodation date irrespective of timeslots and base tariff along with caution deposit will be refunded to their original source of payment.","Re-scheduling of accommodation is not allowed under any circumstances.","In the event of not availing the accommodation on the specified date and stipulated Timeslot, only caution deposit (if any) will be refunded.","TTD Management reserves right of cancellation of the accommodation under some contingent circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","Please contact T.T.D Call Center on 1800 425 41 41 for any enquiries."],accommodationReceiptNotesTirumala:["The allotment of room is only for 24 Hrs and No Extension will be allowed. Pilgrim should invariably vacate the room within 24 Hrs.","Please approach Internet allotment counter at Central Reception Office, Ground Floor, TTD, Tirumala with printed copy of receipt to get scan and for allotment of room.","Pilgrim who book for Accommodation should bring the printed copy of their receipt.","The pilgrim should produce the original ID proof at the time of availing the Accommodation.","Accommodation will not be given to single(one) person and will be allowed to maximum of six persons only.","If Pilgrims fails to avail the accommodation in stipulated Timeslot, No consideration will be done.","Caution deposit ( If any) will be refunded to the original source of the payment post vacation of room.","Re-scheduling of accommodation date is not allowed under any circumstances.","In the event of not availing the accommodation on the specified date and stipulated Timeslot, only caution deposit (if any) will be refunded.","No accommodation will be given to single person/ Unmarried couple / Minors.","No representative of the original Pilgrim will be allowed for scanning in the absence of original Pilgrim. Failing which accommodation will not be provided.","T.T.D. Administration reserves the right of cancellation of the accommodation under any special circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","Please contact Helpdesk on 18004254141 for any enquiries."],accommodationReceiptNotes:["The allotment of room is only for 24 hours and no extension is allowed. Pilgrims should invariably vacate the room within 24 hours.","If the pilgrims fail to avail the accommodation in stipulated timeslot and date, the booking itself will get expire and no consideration will be made in any circumstances.","The Pilgrim should produce the original ID proof at the time of availing the Accommodation.","Caution deposit will be refunded to the original source of payment within 7 banking days, after in-time vacation of the room.","Pilgrims can cancel their Accommodation bookings before minimum 48 hours of accommodation date irrespective of timeslots and base tariff along with caution deposit will be refunded to their original source of payment.","Re-scheduling of accommodation is not allowed under any circumstances.","In the event of not availing the accommodation on the specified date and stipulated Timeslot, only caution deposit (if any) will be refunded.","TTD Management reserves right of cancellation of the accommodation under some contingent circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","Please contact T.T.D Call Center on 1800 425 41 41 for any enquiries."]},"transaction-history":{label:"Transaction History",rulesTxt:"Cancellation and Refund Rules",refreshBtnTxt:"Refresh",noTransactionTxt:"There are no bookings available for this pilgrim’s mobile number.",noTransactionTxt1:"There are no",noTransactionTxt2:"bookings available for this pilgrim’s mobile number.",rules:["Cancellation Refund will be processed as per TTD rules.","No cancellation will be allowed one day before the availing date, irrespective of timeslots. \n Ex: If the availing date is 10th July then cancellation is allowed only till 8th July. \n From 9th July cancellation provision will not be provided.","After cancellation, base tariff and caution deposit (if any) will be refunded to the original source of payment.","Caution deposit (if any) will be refunded post-vacation of room.","In the event of not availing the accommodation on the specified date and stipulated Timeslot, only caution deposit (if any) will be refunded to the original source. (i.e. the Net Baning ID/ Credit Card/ Debit Card ) of the payment and the rent amount will not be refunded under any circumstances"],cancelConfirmTitle:"Cancellation of ID: ",cancelConfirmMessage:"Are you sure you want to cancel the booking?",yesBtn:"Yes",noBtn:"No",heading:"Latest",srNoLbl:"Sr.No.",nameLbl:"Name",bookingNoLbl:"Booking No.",bookingDateLbl:"Booking Date",checkInDateTimeLbl:"Check-in Date/Time",amountLbl:"Amount (₹)",paidAmountLbl:"Paid amount",statusLbl:"Status",viewReceiptBtn:"View Receipt",viewCertificateBtn:"Certificate",bookAccommodationBtn:"Book Accommodation",cancelReceiptBtn:"Cancel",viewLessLbl:"View Less",viewMoreLbl:"View More",availDate:"Check-in Date:",bannerMessage1:"Pilgrims can now book Tirumala accommodation for the month of April, May, June - 2022 from March 26th 9AM onwards",bannerMessage2:"Pilgrims having darshan bookings from Nov 18, 2021 to Dec 10, 2021 and failed to avail because of floods can reschedule as per Terms and Conditions of TTD. Please visit https://tirupatibalaji.ap.gov.in for updates about the quota releases.",bookRescheduleBtn:"Reschedule",offeringDateLbl:"Offering Date",occasionLbl:"On occasion",onBehalfLbl:"On behalf of",bookNo:"Booking No.",AmountLbl:"Amount (₹)","completed-heading":"Completed Transactions","pending-heading":"Pending Transaction"},"dashboard-profile":{firstNameLabel:"First Name",lastNameLabel:"Last Name",dobLabel:"DOB (DD/MM/YYYY)",maleLabel:"Male",femaleLabel:"Female",transgenderLabel:"Transgender",emailLabel:"Email",choosePhotoIdLabel:"Choose a Photo ID proof",behalfLabel:"On Behalf Of",idNumberLabel:"ID Number",saveLabel:"SAVE",firstName:"Invalid first name",lastName:"Invalid last name",dob:"Age should be between 18-120 years",gender:"Invalid gender",email:"Invalid email ID",photoId:"Invalid photoId",idNumber:"Invalid ID number ",mobileLabel:"Mobile",nameLabel:"Name",dobInfo:"DOB",genderLabel:"Gender",Passport:"Passport",aadhaarNo:"Aadhaar No.",editProfile:"EDIT PROFILE",completeProfile:"Complete your profile",completeProfileDesc:"Please provide mandatory information to start booking",updateProfile:"Update Profile",voterid:"Voter ID"},govindaDashboard:{brandText:"Tirumala Tirupati Devasthanams"},pld:{label:"Differently Abled / Sr. Citizen / Medical Cases",subLabel:"Differently Abled / Sr. C / MC"},hundi:{srivari:"Srivari Hundi",ammavari:"Sri Padmavathi Ammavari Hundi"},sevaDip:{label:"Seva Electronic DIP"},arjithaSeva:{label:"Arjitha Seva",sevaNotSelected:"Please select seva name",dateSelected:"Please select an available date",slotSelected:"Please select an available slot",hundiOffering:"Offerings cannot be less than 0",noOfLaddus:"Laddus cannot be less than 0"},virtualSeva:{label:"Virtual Seva"},usses:{label:"Udayasthamana Seva"},apd:{label:"Angapradakshinam",labelBookingDetails:"Angapradakshinam Seva Booking details",subLabel:"Angapradakshinam",bookingError:"The quota for this slot is fully booked now. Kindly choose another slot",bookingCommonError:"We are unable to process your request currently. Please try again after some time",slotCTA:"Choose Slot",errorTxt:"Error",bookingLabel:"Booking reference No.:",bookingTxt:"Your Darshan booking is successful. Please use the above booking reference number for transaction related queries.",downloadTxt:"You can download Darshan receipt by clicking on download button below or from ",transactionHistory:"Transaction history.",download:"Download",shareEmail:"You can share Darshan receipt on email.",emailId:"Email ID",enterEmail:"Enter email ID",sendMail:"Send to email",retry:"Retry",behalfLabel:"On Behalf Of",processes:["This service is exclusively for [B]Locals[/B] residing in Tirumala, Tirupati (Urban & Rural), Chandragiri Mandal and Renigunta Mandal limits. Address mentioned in the AADHAAR card will be taken as local identification","Pilgrims living in Tirupati (Urban & Rural), Tirumala, Chandragiri Mandal and Renigunta Mandal will be considered as Locals. Pilgrims who do not meet this criteria will not be allowed to participate in Angapradakshinam as well as Darshan under any circumstances.","The DIP registration process will start at 10:00 AM and ends at 4:00 PM on every Thursday for Angapradakshinam to be performed on Saturday morning.","Random Dip will be conducted on the same day at 5.00 PM and the selected pilgrims shall pay an amount of Rs.500 per person as a deposit.","The pilgrims those who attend for Angapradakshinam with proper validations and verification are only eligible for refund of Deposit amount.","Deposit amount of Rs.500/- will be forfeited if the pilgrim fails to produce valid identification proof as per the eligibility criteria of this service and will not be allowed to participate in Angapradakshinam as well as Darshan under any circumstances.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh."]},apdReceipt:{instructionsHeaderTxt:"Important Information To The Pilgrims",instructionTxt0:"Pilgrims should report at Special Entry Complex, Vaikuntam-1 as per the specified reporting time only and should not carry any luggage/electronic gadgets while reporting.",instructionTxt1:"Pilgrims participating in Angapradakshinam seva must be in a traditional dress code; Male: Dhoti and upper, Female: Saree / Half saree/ Chudidar with Duppatta",instructionTxt2:"Ladies and gents will be separated to perform Angapradakshinam.",instructionTxt3:"To perform Angapradakshinam, the pilgrim(s) shall attend in wet clothes.",instructionTxt4:"At the time of entry, all the pilgrims should carry individual ticket and shall produce the same original photo id proof used while booking.",instructionTxt5:"Pilgrims shall collect the Laddu Prasadam within 24 hrs from the reporting time for Angapradakshinam.",instructionTxt6:"All the bookings are final: postponement/ cancellation/advancement is not allowed.",instructionTxt7:"TTD reserve the right of cancellation of Seva / Darshan under any circumstances.",instructionTxt8:"Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.",instructionTxt9:"All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh",instructionTxt10:"For more information, Please contact TTD Call Centre (24X7) on 155257.",passportInstructions:["Your Angapradakshinam booking for [booking_date] is successful.","You have made booking using Passport as Non-Resident Indian (NRI) / Foreigner, in view of security reasons, TTD is not issuing the Angapradakshinam Tickets online.","You are requested to approach “SED Complex, Vaikuntam – 1, Tirumala” at your Angapradakshinam reporting time and produce your original passport used while booking and obtain the Angapradakshinam Ticket.","Pilgrims should not carry any luggage/electronic gadgets while reporting.","Pilgrims participating in Angapradakshinam must be in a traditional dress code. Male: Dhoti and upper, Female: Saree / Half saree/ Chudidar with Duppatta","Ladies and gents will be separated to perform Angapradakshinam.","To perform Angapradakshinam, the pilgrim(s) shall attend in wet clothes.","Pilgrims shall collect the Laddu Prasadam within 24 hrs from the reporting time for Angapradakshinam.","All the bookings are final: postponement/ cancellation/advancement is not allowed.","TTD reserve the right of cancellation of Seva / Darshan under any circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","For any information, please contact 155257."],isWeeklyInstructions:["This service is exclusively for [B]Locals[/B] residing in Tirumala, Tirupati (Urban and Rural), Chandragiri Mandal and Renigunta Mandal limits. Address mentioned in the AADHAAR card will be taken as local identification.","Pilgrims living in Tirupati (Urban & Rural), Tirumala, Chandragiri Mandal and Renigunta Mandal will be considered as Locals. Pilgrims who do not meet this criteria will not be allowed to participate in Angapradakshinam as well as Darshan under any circumstances.","Pilgrims are requested to approach “Mahathi Auditorium, Tirupati “between 02:00 PM to 08:00 PM on Friday for collecting the Angapradakshinam seva ticket duly producing original Aadhaar card submitted at the time of registration.","The pilgrims those who attend for Angapradakshinam and whose tickets are scanned are only eligible for refund and rest of all other amounts will be forfeited (both local and non-local).","Deposit amount of Rs.500/- will be forfeited if the pilgrim fails to produce valid identification proof as per the eligibility criteria of this service and will not be allowed to participate in Angapradakshinam.","The Deposit amount of Rs.500/- will be refunded with an automated process within [3] working days.","All the bookings are final: postponement/ cancellation / advancement is not allowed.","TTD reserve the right of cancellation of seva / darshan under any circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","For any clarification, please contact TTD Call Center on 155257."],noteTxt:"NOTE: This is an electronically generated document and does not require any signature.",authorityTxt:"Executive Officer, Tirumala Tirupati Devasthanams",headerTxt1:"Tirumala Tirupati Devasthanams",headerTxt2:"Angapradakshinam",accommodationReceiptTxt:"Accommodation Receipt",headerTxt2Privilge:"Angapradakshinam",headerTxt2SSD:"Sarva Darshanam (Free)",freeLadduTxt:"No. of free laddus:",addnLadduTxt:"Additional Laddus:",addnLadduAmnt:"Additional Laddus Amount:",hundiOffr:"Hundi Offering:",totalAmnt:"Total Amount:",grpBooikngTxt:"Group Booking Id:",bookingDate:"Booking Date:",photoid:"Photo ID Number:",nameTxt:"Pilgrim Name:",gender:"Gender/Age:",reportingTime:"Reporting Time:",reportAt:"Report At:",ticketNotAvailable:"Darshan ticket is not available yet. You will receive an SMS confirmation of your bookings when the transaction is successfully processed by the bank.",ticketNotAvailable2:"Kindly reload this page later.",amount:"Amount:"},timer:{lbl:"We have added you to a virtual queue as a result of exceptionally high demand.",subLbl:"Your expected wait time to enter the booking site is shown below.",timerLbl:"Current wait time is",warning:"Please don't refresh this page."},commonLanding:{loginLabel:"Registered mobile number",logoutLabel:"Are you sure you want to logout?",sessionTimeoutLabel:"Your session has expired. Please login again."},calenderPopupNote:{Note:"To select specific Date / Seva, please click on the available quota. To select all dates and all sevas, click on Select All Seva(s) / Dates check box"},sevaElectronicDIVProcess:{processes:["Registered users can submit Seva Electronic DIP registration form within the stipulated timeframe by filling in pilgrim details and Seva options.","Thomala Seva, Archana, Suprabhatam and Astadala Pada Padmaradhana Seva are made available for Seva Electronic DIP.","Aadhaar card for Indian Citizens and Passport with valid Visa for NRI pilgrims would be accepted for registration.","Modification are not allowed once the form is submitted.","Registration is allowed only if Seva is not availed within last 180 days.","TTD reserves the right to cancel the registration in case of multiple registration made by same person.","Seva tickets will be allotted to the pilgrims based on the random allotment process lucky DIP.","Selected pilgrim list will be published in the website.","Selected pilgrims have to make the payment within timeframe only by logging into ttdevasthanams.ap.gov.in either through Seva Electronic DIP module or through transaction history.","Seva allotted pilgrims are not allowed for availing Seva for the next 180 days from the seva date.","The whole process of registration and allotment is published on the portal for transparency.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh."],passportInstructions:["Passport option is only applicable for NRIs and relevant documents are verified at the time of availing the Seva/darshan.","All work authorization papers, H1B Visas, Green Card holders and Visas of other countries equivalent to H1B Visas, Green Card holders are also allowed under NRI category.","All visit Visas, Student visa, Transit Visas, Business Visas, Medical Visas, Tourist Visas are not allowed under NRI Category.","All foreign nationals are allowed on submission of Passports of respective countries. In respect of Non-Hindus declaration shall be given at VaikuntamQ Complex to secure entry for darshan.","All booking are final. Postponement/ advancement/cancellation/ refund is not allowed.","TTD reserves the right of cancellation of darshan/seva under special circumstance."]},sevaError:{error:"We are unable to process your request at the moment. Please try after sometime"},apdInstruction:{instructions:["Pilgrims should report at Special Entry Complex, Vaikuntam-1 as per the specified reporting time only and should not carry any luggage/electronic gadgets while reporting.","Pilgrims participating in Angapradakshinam seva must be in a traditional dress code; Male: Dhoti and upper, Female: Saree / Half saree/ Chudidar with Duppatta.","Ladies and gents will be separated to perform Angapradakshinam.","To perform Angapradakshinam, the pilgrim(s) shall attend in wet clothes.","At the time of entry, all the pilgrims should carry individual ticket and shall produce the same original photo id proof used while booking.","Pilgrims shall collect the Laddu Prasadam within 24 hrs from the reporting time for Angapradakshinam.","All the bookings are final: postponement/ cancellation/advancement is not allowed.","TTD reserve the right of cancellation of Seva / Darshan under any circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh.","For more information, Please contact TTD Call Centre (24X7) on 155257."]},arjithaSevaInstructions:{pavithrotsavamReceiptInstruction:["Pavithrotsavam seva ticket holders are allowed for 3 days to perform the seva during the seva performance days.","Ticket holders will be allowed for Snapana Thirumanjanam on all the 3 days.","Ticket holders will be allowed for Poornahuthi on the final day of the programme.","For Accomodation, pls contact ARP counter in Tirumala. Subject to availability, accommodation will be provided to the ticket holders for 3 days on payment.Accommodation will not be given to  single person/unmarried/minors.","At the time of entry, all the pilgrims should carry individual ticket and shall produce the same original Photo ID used during booking.","The Pilgrims shall wear traditional dress only. Male: Dhoti, Shirt/ Female: Saree/Half Saree/Chudidar with dupatta.","All the pilgrims shall report as per prescribed time and should not carry any luggage/ electronic gadgets while reporting.","All bookings are final; Postponement / Advancement / Cancellation / Refund is not allowed.","Pilgrims shall collect the Prasadam within 24 Hrs from the reporting time for Darshan/Seva.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","TTD reserves the right of cancellation of seva /Darshan under any Special Circumstances."],floatFestivalReceiptInstructions:["Float festival seva ticket holders are allowed to participate in seva initially and will be allowed for darshan through supatham as per the prescribed timings at the enlighten points.","At the time of entry, all the pilgrims should carry individual tickets and shall produce the same original Photo ID used during booking.","The Pilgrims shall wear traditional dress only. Male: Dhoti, Shirt/ Female: Saree/Half Saree/Chudidar with dupatta.","All the pilgrims shall report as per prescribed time and should not carry any luggage/ electronic gadgets while reporting.","Pilgrim(s) shall collect the Prasadam within 24 Hrs from the reporting time for Darshan/Seva.","All bookings are final; Postponement / Advancement / Cancellation / Refund is not allowed.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","TTD reserves the right of cancellation of seva /Darshan under any Special Circumstances."],SalakatlaVasantotsavamInstructions:["Salakatla Vasanthotsavam seva ticket holders are allowed to participate in seva initially and will be allowed for darshan through supatham as per the prescribed timings at the enlighten points. ","The reporting point for availing Seva is Vasantha Mandapam, Tirumala [Back side of the Temple].","For darshan, report at supatham entry point after completion of seva on the allotment date.","At the time of entry, all the pilgrims should carry individual tickets and shall produce the same original Photo ID used during booking.","The Pilgrims shall wear traditional dress only. Male: Dhoti, Shirt/ Female: Saree/Half Saree/Chudidar with dupatta.","Pilgrims who book for seva should bring the printed copy of their receipt.","All the Pilgrims in the group tickets have to report together.","Entry with chappals/shoes is not permitted into queue lines, mada streets and Temple.","The pilgrims should not carry any luggage/cell phones/electronic gadgets while reporting.","All bookings are FINAL; Postponement / Advancement / Cancellation / Refund is not allowed.","TTD reserves the right of cancellation of seva /Darshan under any Special Circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","Please contact our 24/7 help desk for queries at 1 800 425 333333 and 1 800 425 4141."],homamReceiptInstructionswithoutSed:["The reporting point for availing Seva is [SEVA_LOCATION]","At the time of entry, the pilgrim shall produce the same original Photo ID used during booking. NRI pilgrims shall produce passport with valid Visa/PR.","The pilgrims shall wear Traditional Dress only. Male: Dhoti, Shirt Female: Saree / Half Saree / Chudidar with Dupatta.Grihasthas should wear dhoti and upper cloth for Kalyanothsavam / Laksha Kumkumarchana which involve Sankalpam.","Pilgrims who book for Seva should bring the printed copy of their receipt.","All the Pilgrims in group tickets have to report together.","Entry with chappals/shoes is not permitted into the queue lines, mada streets and Temple.","The pilgrims should not carry any luggage/cell phones/electronic gadgets while reporting.","All bookings are FINAL: prepostponement/advancement/cancellation/refund is not allowed.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","TTD reserves the right of cancellation of the Seva under any Special Circumstances."],homamReceiptInstructions:["[B]Pilgrims participating in Srinivasa Divyaanugraha Homam are entitled to utilize Srivari Special Entry Darshan (Rs. 300/-) via the Special Entry Darshan Complex, Tirumala, on the day of Seva at 03:00 PM.","[B]To avail Srivari Special Entry Darshan, pilgrims must participate in Srinivasa Divyaanugraha Homam and get validate your seva ticket without fail.","The reporting point for availing Seva is [SEVA_LOCATION]","At the time of entry, the pilgrim shall produce the same original Photo ID used during booking. NRI pilgrims shall produce passport with valid Visa/PR.","The pilgrims shall wear Traditional Dress only. Male: Dhoti, Shirt Female: Saree / Half Saree / Chudidar with Dupatta.Grihasthas should wear dhoti and upper cloth for Kalyanothsavam / Laksha Kumkumarchana which involve Sankalpam.","Pilgrims who book for Seva should bring the printed copy of their receipt.","All the Pilgrims in group tickets have to report together.","Entry with chappals/shoes is not permitted into the queue lines, mada streets and Temple.","The pilgrims should not carry any luggage/cell phones/electronic gadgets while reporting.","All bookings are FINAL: prepostponement/advancement/cancellation/refund is not allowed.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","TTD reserves the right of cancellation of the Seva under any Special Circumstances."],receiptInstruction:["The reporting point for availing Seva is [SEVA_LOCATION]","Pilgrims who book for Seva should bring the printed copy of their receipt","At the time of entry, all the pilgrims should carry seva ticket and shall produce the same original photo id proof during booking.","All the pilgrims shall report as per the prescribed time only and should not carry any luggage/electronic gadgets while reporting.","Pilgrims shall wear traditional dress only. Male: dhoti and upper cloth. Female: saree/Half saree/chudidar with Duppatta.","All the pilgrims in group ticket have to report together.","Entry with chappals/shoes is not permitted into the queue lines, mada streets and Temple.","Children [below 12 years] of age are not permitted for morning sevas [Thomala, Archana, Astadalam & Abhishekam].","Pilgrim(s) shall collect the Prasadam within 24 Hrs from the reporting time for Darshan/Seva. ","All the bookings are final: postponement/ cancellation/advancement is not allowed.","TTD reserve the right of cancellation of seva/darshan under any circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh.","For any information please contact [B]155257."],nonSrivariTempleInstructions:["The reporting point for availing Seva is [SEVA_LOCATION]","At the time of entry, the pilgrim shall produce the same original Photo ID used during booking. NRI pilgrims shall produce passport with valid Visa/PR.","The pilgrims shall wear Traditional Dress only. Male: Dhoti, Shirt Female: Saree / Half Saree / Chudidar with Dupatta.Grihasthas should wear dhoti and upper cloth for Kalyanothsavam / Laksha Kumkumarchana which involve Sankalpam.","Pilgrims who book for Seva should bring the printed copy of their receipt.","All the Pilgrims in group tickets have to report together.","Entry with chappals/shoes is not permitted into the queue lines, mada streets and Temple.","The pilgrims should not carry any luggage/cell phones/electronic gadgets while reporting.","All bookings are FINAL: prepostponement/advancement/cancellation/refund is not allowed.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh.","TTD reserves the right of cancellation of the Seva under any Special Circumstances."],sriChennakeshavaInstructions:["The reporting point for availing Seva is [SEVA_LOCATION]","Please make sure to attend the Arjitha Kalyanotsavam with the booking ticket receipt (hard copy) without fail.","At the time of entry, the pilgrim shall produce the same original Photo ID used during booking. NRI pilgrims shall produce passport with valid Visa/PR.","The pilgrims shall wear Traditional Dress only. Male: Dhoti, Shirt Female: Saree / Half Saree / Chudidar with Dupatta.Grihasthas should wear dhoti and upper cloth for Kalyanothsavam / Laksha Kumkumarchana which involve Sankalpam.","Pilgrims who book for Seva should bring the printed copy of their receipt.","All the Pilgrims in group tickets have to report together.","Entry with chappals/shoes is not permitted into the queue lines, mada streets and Temple.","The pilgrims should not carry any luggage/cell phones/electronic gadgets while reporting.","All bookings are FINAL: prepostponement/advancement/cancellation/refund is not allowed.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","TTD reserves the right of cancellation of the Seva under any Special Circumstances."],pushpayagamInstructions:["Pushpayagam seva ticket holders are allowed for snapana thirumanjanam conducted from [9.00 Am to 11.00 AM] along with pushpayagam seva [1.00Pm to  5.00PM].","At the time of entry, all the pilgrims should carry individual tickets and shall produce the same original Photo ID used during booking.","The Pilgrims shall wear traditional dress only. Male: Dhoti, Shirt/ Female: Saree/Half Saree/Chudidar with dupatta.","All the pilgrims shall report as per prescribed time and should not carry any luggage/ electronic gadgets while reporting.","Pilgrims shall collect the Prasadam within 24 Hrs from the reporting time for Darshan.","All bookings are final; Postponement / Advancement / Cancellation / Refund is not allowed.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","TTD reserves the right of cancellation of seva /Darshan under any Special Circumstances."]},virtualSevaInstructions:{popupInstructions:["Gruhastas in traditional dress shall present at Seva time specified in the receipt before the TV sets in their homes to participate in Srivari Seva.","Kalyanotsavam Gruhastha will be allowed for sankalpam during first 10 minutes","Kalyanotsavam Gruhastas are allowed for sankalpam","Gruhastas shall follow the instructions of Archaka Swamy (Priest) during the performance of Seva ","Kalyanotsam Gruhastas can be collected at counter no. 32 & 33 of Laddu Complex at Tirumala after availing Darshan","This is purely an Online Seva and pilgrims are not allowed to attend physically at the Temple","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh."],privilegeReceiptInstructions:["Kalyanotsavam Gruhastas are entitled to prasadam consisting of 1 Upper Cloth/1 Blouse Piece","The Prasadam can be collected at counter No. 32 & 33 of Laddu complex at Tirumala after availing Darshan","NRI pilgrims shall produce passport with valid visa/PR.","At the time of entry, all the pilgrims should carry seva ticket and shall produce the same original photo id proof during booking.","All the pilgrims shall report as per the prescribed time only and should not carry any luggage/electronic gadgets while reporting.","Pilgrims shall wear traditional dress only. [Male: dhoti and upper cloth. Female: saree/Half saree/chudidar with Duppatta.","Age proof shall be produced for children below 12 years to gain free cost for darshan.","Pilgrims shall collect the Prasadam within 12 hrs from the reporting time. ","All the bookings are final: postponement/ cancellation/advancement is not allowed.","TTD reserve the right of cancellation of seva/darshan under any circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","For any information please contact [B]155257."],normalReceiptInstructions:["The Prasadam can be collected at counter No. 32 & 33 of Laddu complex at Tirumala after availing Darshan","NRI pilgrims shall produce passport with valid visa/PR.","At the time of entry, all the pilgrims should carry seva ticket and shall produce the same original photo id proof during booking.","All the pilgrims shall report as per the prescribed time only and should not carry any luggage/electronic gadgets while reporting.","Pilgrims shall wear traditional dress only. [Male: dhoti and upper cloth. Female: saree/Half saree/chudidar with Duppatta.","Age proof shall be produced for children below 12 years to gain free cost for darshan.","Pilgrims shall collect the Prasadam within 12 hrs from the reporting time. ","All the bookings are final: postponement/ cancellation/advancement is not allowed.","TTD reserve the right of cancellation of seva/darshan under any circumstances.","Pilgrims with cardiac disease and other comorbidities like diabetes, hypertension are advised to avoid climbing uphill to Tirumala.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh","For any information please contact [B]155257."]},kalyanavedikaInstructions:{receiptInstructions:["Bride and Bride Groom must necessarily belong to [B]Hindu Religion.[/B]","Bride must have completed [B]18 years[/B] of Age and Bride Groom [B]21 years[/B] as on the date of marriage.","Certificates of Age of the Bride and Bride Groom must be produced to the TTD Authorities before marriage [B](School Certificate, Birth Certificate, PAN Card, Passport, Driving License)[/B] if any one.","Certificate relating to proof of Residential Address of the Bride and Bride Groom [B](Aadhaar Card or Residential Certificate obtained from the concern Thasildar)[/B] must be produced.","Parents of the Bride and Bride Groom must be present at the time of marriage. In case, Father or Mother Expired will be produce the Death Certificate at the same time Guardian will be permitted, duly producing the evidence of Identity [B](Aadhaar Card).[/B]","Love Marriages and Second Marriages are not permitted.","Depending on demand on particular Muhurtham day, marriages may be performed in groups only.","After performance of marriage at kalyanavedika, TTD will issue a receipt of darshan. Six persons are allowed for Darshan at free of cost through Special Entry Darshan (Rs.300/-) 'Q' line entry, Tirumala. Bride, Bridegroom and four other persons (Parents/Guardians of the couple).","One Rs.50/- room will be provided free of cost for 24 hours and extension will be on payment of second day. Another room will be provided on payment with subject to availability.","Pilgrims can use the same receipt of darshan to get the marriage certificate from Government registration office situated at Tirumala.",'TTD will provide "Pasupu and Kumkuma to the couples.',"After completion of On-line Application to download the Booking Application and Attested with [B][ Bride Groom and Bride ][/B] concerned [B]MRO/Thasildhar[/B] only.","Pilgrim should come with Parents of the Bride and Bride Groom must be present at Original Documents/Certificates for verification along with Attested On-line Booking Application and report at Kalyanavedika before [B]One Day[/B] at Office Hours between [B]09.00 AM to 05.00[/B] PM for verification and confirm the Marriage.","All Legal Options (ALO) shall alone have exclusive jurisdiction of Tirupati only or High Court of Andhra Pradesh"]},temples:{templesDonationNotes:["Tirumala Tirupati Devasthanams serves Annadhanam to around 500 pilgrims daily at local temples.","Devotees can now donate to the Anna Prasadam Scheme, choosing to sponsor meals for 25 to 500 persons via the dropdown menu. The donor's name will be displayed at the Annadhanam premises on the chosen day.","Alternatively, donors can contribute any amount starting from ₹1 by selecting the 'Any Other Amount' option in the dropdown and entering the desired amount.","Please contribute generously and be part of this noble service, receiving the blessings of Lord Venkateswara for you and your family."]},passportFields:{countryErr:"Please enter valid country name",visaNumberErr:"Please enter valid visa number",visaTypeErr:"Please enter valid visa type",visaValidityDateErr:"Please enter valid date"}}}},84525:function(e,a,t){"use strict";t.d(a,{k:function(){return s},l:function(){return r}});var i,n,o=(i=t(16275).Z.en,{setLocaleData:function(e){i=e},getLocaleData:function(e,a){var t=i[e],n=(void 0===t?{}:t)[a];return(void 0===n?"":n)||"..."}}),r=o.setLocaleData,s=o.getLocaleData},93009:function(e,a,t){"use strict";t.d(a,{Ec:function(){return r},K4:function(){return y},Lp:function(){return w},aM:function(){return g},dD:function(){return p},lx:function(){return b},td:function(){return f}});var i=t(31807),n=t.n(i),o=t(11163);function r(){var e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:void 0,a=e;n()&&(a=a||window.location.pathname);var t=(a=s(a)).split("/");return t[0]?t[0]:""}function s(){var e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:"";return l(d,c)(e)}var l=function(){for(var e=arguments.length,a=Array(e),t=0;t<e;t++)a[t]=arguments[t];return function(e){return a.reduce(function(e,a){return a(e)},e)}};function c(){var e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:"";return u(e,"/")?h(e,"/"):e}function d(){var e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:"";return!function(){var e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:"",a=arguments.length>1?arguments[1]:void 0;return!!e&&e.substring(0,1)===a}(e,"/")?e:m(e,"/")}function u(){var e=arguments.length>0&&void 0!==arguments[0]?arguments[0]:"",a=arguments.length>1?arguments[1]:void 0;return!!e&&e.substr